# Copy to .env.local (git-ignored). Never commit real tokens.
#
# Backend origin. Leave empty to run fully on SAMPLE mock data (no backend needed).
#   public app on nikopi5 (Tailscale Funnel):  https://nikopi5.tail4aaac7.ts.net:10000
#   local uvicorn / ssh tunnel:                 http://localhost:9100
NEXT_PUBLIC_ZALU_API=
# Bearer token = ZALU_TOKEN on nikopi5. Prefer typing it in the app (top right, "Data source"):
# NEXT_PUBLIC_* values are compiled into the browser bundle.
NEXT_PUBLIC_ZALU_TOKEN=
